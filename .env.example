# Copy to .env and fill in. .env is gitignored — never commit real values.

# MongoDB: local docker-compose for dev, Atlas SRV string for production
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=nimbus

# Auth — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS S3
S3_BUCKET_NAME=nimbus-storage-<account-id>
S3_REGION=ap-south-1
PRESIGNED_URL_EXPIRE_SECONDS=3600

# OAuth (optional). Leave blank to keep Google/GitHub sign-in disabled.
# Client IDs are public; secrets are not — on Lambda these come from the
# CloudFormation parameters, never committed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
