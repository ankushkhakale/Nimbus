# Base URL of the Nimbus API (no trailing slash, no /api/v1 suffix).
# Local backend: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# OAuth client IDs (public — they appear in the authorize URL). Leave
# blank to hide that provider's button. Must match the client IDs whose
# secrets are configured on the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
